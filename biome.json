{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"formatter": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"noBannedTypes": "off"
			},
			"style": {
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noExplicitAny": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["__tests__/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"useIterableCallbackReturn": "off",
						"noAssignInExpressions": "off"
					},
					"complexity": {
						"noBannedTypes": "off"
					},
					"correctness": {
						"noUnusedImports": "off"
					},
					"performance": {
						"noAccumulatingSpread": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": { "quoteStyle": "single" }
	},
	"markdown": { "formatter": { "enabled": false } },
	"yaml": { "formatter": { "enabled": false } },
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true }
}
