{
	"name": "@generalworks/vuf",
	"version": "1.2.1",
	"type": "module",
	"exports": {
		".": "./dist/core/index.js",
		"./vue": "./dist/vue/index.js",
		"./solid": "./dist/solid/index.js",
		"./solid2": "./dist/solid2/index.js",
		"./messages/ja": "./dist/messages/ja.js",
		"./messages/en": "./dist/messages/en.js"
	},
	"files": [
		"dist"
	],
	"peerDependencies": {
		"vue": "^3.4",
		"solid-js": ">=1.8 <2 || >=2.0.0-0"
	},
	"peerDependenciesMeta": {
		"vue": {
			"optional": true
		},
		"solid-js": {
			"optional": true
		}
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:fix-unsafe": "biome check --write --unsafe .",
		"format": "biome format --write .",
		"test": "bun run test:base && bun run test:solid1 && bun run test:solid2",
		"test:base": "bun test __tests__/core_mod.test.ts __tests__/messages.test.ts __tests__/messages_subpath.test.ts __tests__/validators.test.ts __tests__/vuf2.test.ts __tests__/vue_formFactory.test.ts __tests__/performance.test.ts",
		"test:solid1": "bun test __tests__/solid_formFactory.test.ts __tests__/solid_vufSolid.test.ts __tests__/adapter_contract.test.ts --conditions browser --preload ./scripts/bun-solid1.ts",
		"test:solid2": "bun test __tests__/solid2_formFactory.test.ts __tests__/solid2_vufSolid.test.ts __tests__/adapter_contract_solid2.test.ts --conditions browser",
		"build": "tsup",
		"jsr:check": "bunx jsr publish --dry-run --allow-dirty",
		"fix": "bun run lint:fix && bun run format",
		"check": "bun run lint && bun run typecheck && bun run jsr:check"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.2",
		"bun-types": "^1.2.21",
		"solid-js-v1": "npm:solid-js@^1.9.14",
		"tsup": "^8.5.0",
		"typescript": "^5.9.2"
	},
	"dependencies": {
		"v8n": "^1.5.1"
	},
	"overrides": {
		"solid-js": "2.0.0-rc.0",
		"vue": "3.5.20"
	}
}
